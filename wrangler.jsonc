{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ferrats-blog",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"vars": {
		"EMDASH_SITE_URL": "https://ferrats-blog.leoferrato.workers.dev",
	},
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "dc7399cb09bd40408aca8cb9a9036eb5",
		},
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ferrats-blog",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "ferrats-blog-media",
		},
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
